{
  "entities": {
    "budgets": {
      "title": "Shared Budget Space",
      "description": "Shared household budget space between partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User emails or UIDs permitted to view and edit this budget"
        },
        "inviteCode": { "type": "string" },
        "currency": { "type": "string" },
        "budgetConfig": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "members"]
    },
    "budgetData": {
      "title": "Budget Data Payload",
      "description": "Real-time state for accounts, categories, transactions, reservations, loans, and settings",
      "type": "object",
      "properties": {
        "budgetId": { "type": "string" },
        "accounts": { "type": "array" },
        "categories": { "type": "array" },
        "transactions": { "type": "array" },
        "reservations": { "type": "array" },
        "loans": { "type": "array" },
        "plannedPayments": { "type": "array" },
        "budgetConfig": { "type": "object" },
        "settings": { "type": "object" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["budgetId", "updatedAt"]
    },
    "userProfiles": {
      "title": "User Profile",
      "description": "User profile with active budget reference",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "activeBudgetId": { "type": "string" },
        "partnerEmail": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  }
}
